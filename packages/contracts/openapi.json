{
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/otp/request": {
      "post": {
        "operationId": "AuthController_requestOtp",
        "parameters": [
          {
            "name": "accept-language",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResponse"
                }
              }
            }
          }
        },
        "summary": "Send a one-time code by SMS",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "AuthController_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "summary": "Verify the code and sign in (creates rider and driver accounts on first sign-in)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairView"
                }
              }
            }
          }
        },
        "summary": "Exchange a refresh token for a new token pair (rotation)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "End this session",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "End every session of the signed-in user on all devices",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "MeController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "operationId": "MeController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update name or language",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/admin/users": {
      "get": {
        "operationId": "AdminUsersController_list",
        "parameters": [
          {
            "name": "partnerId",
            "required": false,
            "in": "query",
            "description": "Super admins only; partner staff always see their own partner",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rider",
                "driver",
                "partner_admin",
                "dispatcher",
                "super_admin"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Search by name or phone digits",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 100,
              "default": 20,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List users in the caller’s partner (all partners for super admins)",
        "tags": [
          "admin: users"
        ]
      },
      "post": {
        "operationId": "AdminUsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStaffDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Add a staff member who signs in to the admin dashboard",
        "tags": [
          "admin: users"
        ]
      }
    },
    "/v1/admin/users/{id}": {
      "get": {
        "operationId": "AdminUsersController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "admin: users"
        ]
      },
      "patch": {
        "operationId": "AdminUsersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Rename, change role or suspend a user",
        "tags": [
          "admin: users"
        ]
      }
    },
    "/v1/admin/partners": {
      "get": {
        "operationId": "PartnersController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PartnerView"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "All partners for super admins; the caller’s own partner otherwise",
        "tags": [
          "admin: partners"
        ]
      },
      "post": {
        "operationId": "PartnersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePartnerDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Register a licensed transport partner",
        "tags": [
          "admin: partners"
        ]
      }
    },
    "/v1/admin/partners/{id}": {
      "get": {
        "operationId": "PartnersController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "admin: partners"
        ]
      },
      "patch": {
        "operationId": "PartnersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePartnerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Edit a partner or suspend it (signs out all its staff)",
        "tags": [
          "admin: partners"
        ]
      }
    }
  },
  "info": {
    "title": "Ride Platform API",
    "description": "Scheduled ride subscriptions run by licensed partners. Errors use one shape: { error: { code, message, details? }, requestId }. Send Accept-Language: ar|en.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "0501234567",
            "description": "Saudi mobile number in any common format"
          },
          "app": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "admin"
            ],
            "description": "The app the user is signing in to"
          }
        },
        "required": [
          "phone",
          "app"
        ]
      },
      "OtpRequestResponse": {
        "type": "object",
        "properties": {
          "sent": {
            "type": "boolean",
            "example": true
          },
          "expiresIn": {
            "type": "number",
            "example": 300,
            "description": "Seconds until the code expires"
          },
          "resendAfter": {
            "type": "number",
            "example": 60,
            "description": "Seconds before another code may be requested"
          }
        },
        "required": [
          "sent",
          "expiresIn",
          "resendAfter"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "0501234567",
            "description": "Saudi mobile number in any common format"
          },
          "app": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "admin"
            ],
            "description": "The app the user is signing in to"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "app",
          "code"
        ]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "example": "+966501234567"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "partner_admin",
              "dispatcher",
              "super_admin"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "admin"
            ]
          },
          "partnerId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "suspended"
            ]
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "phone",
          "name",
          "role",
          "audience",
          "partnerId",
          "locale",
          "status",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "example": 900
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "isNewUser": {
            "type": "boolean",
            "description": "True when this sign-in created the account"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user",
          "isNewUser"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token returned at sign-in or the last refresh"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPairView": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "example": 900
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "محمد"
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ]
          }
        }
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserView"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "CreateStaffDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "0501234567"
          },
          "name": {
            "type": "string",
            "example": "أحمد"
          },
          "role": {
            "type": "string",
            "enum": [
              "partner_admin",
              "dispatcher",
              "super_admin"
            ]
          },
          "partnerId": {
            "type": "string",
            "format": "uuid",
            "description": "Required for partner roles when the caller is a super admin"
          }
        },
        "required": [
          "phone",
          "name",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "partner_admin",
              "dispatcher"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "suspended"
            ]
          }
        }
      },
      "PartnerView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameAr": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "legalName": {
            "type": "string",
            "nullable": true
          },
          "crNumber": {
            "type": "string",
            "nullable": true
          },
          "tgaLicenseNumber": {
            "type": "string",
            "nullable": true
          },
          "contactPhone": {
            "type": "string",
            "nullable": true
          },
          "commissionBps": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "staffCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nameAr",
          "nameEn",
          "legalName",
          "crNumber",
          "tgaLicenseNumber",
          "contactPhone",
          "commissionBps",
          "status",
          "staffCount",
          "createdAt"
        ]
      },
      "CreatePartnerDto": {
        "type": "object",
        "properties": {
          "nameAr": {
            "type": "string",
            "example": "شركة النقل المتحدة"
          },
          "nameEn": {
            "type": "string",
            "example": "United Transport Co."
          },
          "legalName": {
            "type": "string"
          },
          "crNumber": {
            "type": "string",
            "example": "1010123456",
            "description": "Commercial registration (10 digits)"
          },
          "tgaLicenseNumber": {
            "type": "string",
            "description": "Transport General Authority licence number"
          },
          "contactPhone": {
            "type": "string",
            "example": "0112345678"
          },
          "commissionBps": {
            "type": "number",
            "example": 1500,
            "description": "Commission in basis points (1500 = 15%)"
          }
        },
        "required": [
          "nameAr",
          "nameEn"
        ]
      },
      "UpdatePartnerDto": {
        "type": "object",
        "properties": {
          "nameAr": {
            "type": "string",
            "example": "شركة النقل المتحدة"
          },
          "nameEn": {
            "type": "string",
            "example": "United Transport Co."
          },
          "legalName": {
            "type": "string"
          },
          "crNumber": {
            "type": "string",
            "example": "1010123456",
            "description": "Commercial registration (10 digits)"
          },
          "tgaLicenseNumber": {
            "type": "string",
            "description": "Transport General Authority licence number"
          },
          "contactPhone": {
            "type": "string",
            "example": "0112345678"
          },
          "commissionBps": {
            "type": "number",
            "example": 1500,
            "description": "Commission in basis points (1500 = 15%)"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          }
        }
      }
    }
  }
}
