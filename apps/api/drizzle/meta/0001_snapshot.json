          "name": "users_partner_role_ck",
          "value": "(\"users\".\"role\" IN ('partner_admin','dispatcher') AND \"users\".\"partner_id\" IS NOT NULL)\n        OR (\"users\".\"role\" = 'super_admin' AND \"users\".\"partner_id\" IS NULL)\n        OR \"users\".\"role\" IN ('rider','driver')"
