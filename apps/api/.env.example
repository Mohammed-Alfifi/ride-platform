# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API from a browser (admin dashboard)
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
# API docs at /docs are on outside production; set true to keep them in production
SWAGGER_ENABLED=false

# --- Data stores ---
DATABASE_URL=postgres://ride:ride@localhost:5432/ride
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Pepper mixed into OTP and refresh-token hashes. Generate with: openssl rand -base64 32
HASH_PEPPER=change-me-to-another-long-random-string

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# console = print codes to the log (development only). Production must use a real provider.
SMS_PROVIDER=console
# Fixed code for store-review / QA test accounts (comma-separated phones). Leave empty in production unless needed.
OTP_TEST_PHONES=
OTP_TEST_CODE=

# --- Seed ---
# The first super admin, created by `pnpm db:seed`. E.164 format, e.g. +9665XXXXXXXX
SUPER_ADMIN_PHONE=
SUPER_ADMIN_NAME="Platform Owner"

# --- Monitoring (optional) ---
SENTRY_DSN=
