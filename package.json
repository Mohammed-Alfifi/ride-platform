{
  "name": "ride-platform",
  "private": true,
  "description": "Scheduled ride subscription platform (multi-partner): API, admin dashboard, rider and driver apps.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ride/api start:dev",
    "dev:admin": "pnpm --filter @ride/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
