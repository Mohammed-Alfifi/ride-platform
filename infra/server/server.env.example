# ---- Copy to server.env. setup.sh creates it and fills every secret for you. ----
# Values with spaces: write them as they are, without quotes.

# Addresses. Free option: two DuckDNS names pointing at the server's IP, e.g.
#   API_DOMAIN=ride-api.duckdns.org   ADMIN_DOMAIN=ride-admin.duckdns.org
# The rider web app (for iPhone) is served at https://API_DOMAIN/app/
API_DOMAIN=
ADMIN_DOMAIN=
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=

# Database password (setup.sh generates one).
DB_PASSWORD=

# --- API ---
NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false
JWT_ACCESS_SECRET=
HASH_PEPPER=
DATA_ENCRYPTION_KEY=
# Keep people signed in for 90 days (each use extends it), so access codes are rarely needed again.
REFRESH_TOKEN_TTL_DAYS=90

# --- Pilot without running costs ---
# invite: only phones you invite (dashboard > Invited people / Join requests) can use the apps.
ACCESS_MODE=invite
# none: no SMS. People sign in with an 8-digit access code you send on WhatsApp from the dashboard.
# Later, with a Saudi SMS account: SMS_PROVIDER=taqnyat, TAQNYAT_TOKEN=..., SMS_SENDER=...
SMS_PROVIDER=none
ACCESS_CODE_TTL_DAYS=7

# manual: riders pay by bank transfer or cash; you record it in the dashboard (Subscriptions > Record payment).
# Later: PAYMENT_PROVIDER=tap with TAP_SECRET_KEY and TAP_MERCHANT_ID.
PAYMENT_PROVIDER=manual
PAYMENT_INSTRUCTIONS_AR=حوّل المبلغ إلى الحساب: (اسم البنك)، الآيبان SA00 0000 0000 0000 0000 0000، باسم (اسم المنشأة). ثم أرسل صورة الإيصال على الواتساب.
PAYMENT_INSTRUCTIONS_EN=Transfer the amount to (bank), IBAN SA00 0000 0000 0000 0000 0000, account name (business). Then send the receipt on WhatsApp.

# Support WhatsApp number shown in the apps and on the public pages (05XXXXXXXX).
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
# Shown in the terms and privacy pages.
OPERATOR_NAME=
OPERATOR_CR=
OPERATOR_CITY=الرياض

# Stop new subscriptions above this many active ones (0 = no limit).
PILOT_MAX_ACTIVE_SUBSCRIPTIONS=30
# Alert the team when a driver has not set off this many minutes before pick-up.
LATE_ALERT_MINUTES=10
# Driver location history is deleted after this many days.
LOCATION_RETENTION_DAYS=30

# Push notifications (free Firebase plan): the service account JSON file, base64 on one line:
#   base64 -w0 firebase-service-account.json
FCM_SERVICE_ACCOUNT=

# Where the download page links the Android apps (the project's latest GitHub release).
DOWNLOAD_BASE_URL=https://github.com/Mohammed-Alfifi/ride-platform/releases/latest/download

JOBS_ENABLED=true
# Off-server backup target for rclone (e.g. gdrive:mishwar-backups). Empty: local only.
BACKUP_REMOTE=
