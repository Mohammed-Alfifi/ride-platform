# ---- Copy to server.env. setup.sh creates it and fills every secret for you. ----

# Addresses. Free option: two DuckDNS names pointing at the server's IP, e.g.
#   API_DOMAIN=ride-api.duckdns.org   ADMIN_DOMAIN=ride-admin.duckdns.org
API_DOMAIN=
ADMIN_DOMAIN=
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=

# Database password (setup.sh generates one).
DB_PASSWORD=

# --- API ---
# staging = pilot/demo: test payment page and SMS codes in the server log are allowed.
# Switch to production only with a real SMS provider and Tap (or Moyasar) keys.
NODE_ENV=staging
LOG_LEVEL=info
JWT_ACCESS_SECRET=
HASH_PEPPER=
DATA_ENCRYPTION_KEY=

SMS_PROVIDER=console
# Phones that sign in with a fixed code while there is no SMS provider (comma separated, +9665...).
OTP_TEST_PHONES=
OTP_TEST_CODE=

PAYMENT_PROVIDER=sandbox
# With Tap test keys (sk_test_...) you can try real card pages without real money:
# PAYMENT_PROVIDER=tap
# TAP_SECRET_KEY=
# TAP_MERCHANT_ID=

JOBS_ENABLED=true
SWAGGER_ENABLED=true
