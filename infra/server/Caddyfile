# HTTPS certificates are issued and renewed automatically (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip

	# The rider app for iPhone and browsers (Flutter web build).
	redir /app /app/
	handle_path /app/* {
		root * /srv/web
		@static path *.js *.wasm *.png *.otf *.ttf *.json
		header @static Cache-Control "public, max-age=3600"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		request_body {
			max_size 15MB
		}
		reverse_proxy api:3000
	}
}

{$ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy admin:3001
}
